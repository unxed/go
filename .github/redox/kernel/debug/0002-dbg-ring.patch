index 0000000..5509da3
--- /dev/null
+++ b/src/dbgring.rs
@@ -0,0 +1,128 @@
+//! DEBUG: lock-free per-CPU event ring for hunting context-switch bugs. No formatting in the hot
+//! path: an event is a few stores. Dumped from the panic path and by a "no progress" watchdog.
+use alloc::sync::Arc;
+use core::{
+    cell::UnsafeCell,
+    sync::atomic::{AtomicBool, AtomicU64, Ordering},
+};
+
+pub const NEV: usize = 2048;
+const NCPU: usize = 8;
+
+#[derive(Clone, Copy)]
+pub struct Ev {
+    pub seq: u64,
+    pub a: u64,
+    pub b: u64,
+    pub code: u8,
+}
+const EV0: Ev = Ev { seq: 0, a: 0, b: 0, code: 0 };
+
+pub struct Ring {
+    ev: UnsafeCell<[Ev; NEV]>,
+    head: AtomicU64,
+}
+unsafe impl Sync for Ring {}
+#[allow(clippy::declare_interior_mutable_const)]
+const R0: Ring = Ring { ev: UnsafeCell::new([EV0; NEV]), head: AtomicU64::new(0) };
+static RINGS: [Ring; NCPU] = [R0; NCPU];
+static SEQ: AtomicU64 = AtomicU64::new(1);
+static DUMPED: AtomicBool = AtomicBool::new(false);
+/// Bumped on every switch to a non-idle context (progress indicator for the watchdog).
+pub static PROGRESS: AtomicU64 = AtomicU64::new(0);
+static LAST_PROGRESS: AtomicU64 = AtomicU64::new(0);
+static LAST_CHANGE_NS: AtomicU64 = AtomicU64::new(0);
+
+// event codes
+pub const SWITCH_TO: u8 = 1; // a = prev_id<<32|next_id, b = prev_st<<8|next_st
+pub const DEAD_SET: u8 = 2; // a = id
+pub const UNBLOCK: u8 = 3; // a = id, b = status code seen | result<<8
+pub const WAKEUP: u8 = 4; // a = id, b = target cpu (or 255)
+pub const BLOCK: u8 = 5; // a = id, b = 1 if it really blocked
+pub const HARDBLOCK: u8 = 6; // a = id
+pub const IDLE_RET: u8 = 7; // a = queue_len, b = sched id
+pub const EARLY_SAME: u8 = 8; // a = current id
+pub const EXIT_STEP: u8 = 9; // a = id, b = step
+pub const FORCEKILL: u8 = 10; // a = target id, b = old status code
+pub const PICK: u8 = 11; // a = picked id (or 0 = none) , b = prev sched id
+pub const DIRECT_BACK: u8 = 12; // a = current id
+pub const EXCEPTION: u8 = 13; // a = id
+
+#[inline(always)]
+pub fn ev(code: u8, a: u64, b: u64) {
+    let cpu = (crate::cpu_id().get() as usize).min(NCPU - 1);
+    let r = &RINGS[cpu];
+    let i = r.head.fetch_add(1, Ordering::Relaxed) as usize % NEV;
+    let seq = SEQ.fetch_add(1, Ordering::Relaxed);
+    unsafe {
+        (*r.ev.get())[i] = Ev { seq, a, b, code };
+    }
+}
+
+pub fn st_code(s: &crate::context::Status) -> u64 {
+    use crate::context::Status::*;
+    match s {
+        Runnable => 1,
+        Blocked => 2,
+        HardBlocked { .. } => 3,
+        Dead { .. } => 4,
+    }
+}
+
+/// Print the last `per_cpu` events of every CPU (lines "R seq cpu code a b"; sort by seq).
+pub fn dump(reason: &str, per_cpu: usize) {
+    if DUMPED.swap(true, Ordering::SeqCst) {
+        return;
+    }
+    println!("DBGRING-BEGIN {}", reason);
+    for (cpu, r) in RINGS.iter().enumerate() {
+        let head = r.head.load(Ordering::Relaxed) as usize;
+        let n = per_cpu.min(head).min(NEV);
+        for k in 0..n {
+            let i = (head - 1 - k) % NEV;
+            let e = unsafe { (*r.ev.get())[i] };
+            println!("R {} {} {} {:x} {:x}", e.seq, cpu, e.code, e.a, e.b);
+        }
+    }
+    println!("DBGRING-END");
+}
+
+/// Called on every CPU tick that found nothing to run; if no context switch to a non-idle
+/// context happened for ~15 s, dump the ring and the state of all contexts, once.
+pub fn watchdog(now_ns: u128) {
+    let now = now_ns as u64;
+    let p = PROGRESS.load(Ordering::Relaxed);
+    if p != LAST_PROGRESS.load(Ordering::Relaxed) {
+        LAST_PROGRESS.store(p, Ordering::Relaxed);
+        LAST_CHANGE_NS.store(now, Ordering::Relaxed);
+        return;
+    }
+    let last = LAST_CHANGE_NS.load(Ordering::Relaxed);
+    if last == 0 {
+        LAST_CHANGE_NS.store(now, Ordering::Relaxed);
+        return;
+    }
+    if now.saturating_sub(last) > 15_000_000_000 && !DUMPED.load(Ordering::Relaxed) {
+        dump("watchdog: no switch to a non-idle context for 15 s", 120);
+        dump_contexts();
+    }
+}
+
+pub fn dump_contexts() {
+    let mut token = unsafe { crate::sync::CleanLockToken::new() };
+    let mut token2 = unsafe { crate::sync::CleanLockToken::new() };
+    println!("DBGCTX-BEGIN");
+    let ctxs = crate::context::contexts(token.downgrade());
+    for c in ctxs.iter() {
+        let lock = &c.0;
+        if let Some(g) = lock.try_read(token2.token()) {
+            println!(
+                "C ptr={:x} id={} name={} status={:?} reason={} running={} sched={} cpu={:?} wake={:?} pid={}",
+                Arc::as_ptr(lock) as usize, g.debug_id, g.name.as_str(), g.status, g.status_reason, g.running, g.currently_scheduled, g.cpu_id, g.wake, g.pid
+            );
+        } else {
+            println!("C (locked)");
+        }
+    }
+    println!("DBGCTX-END");
+}
